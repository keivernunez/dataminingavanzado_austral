      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#Dataset de review de peliculas\n",
        "Movie_data = pd.read_csv(\"https://raw.githubusercontent.com/Lashanghainesa/dataset/main/IMDB%20Dataset.csv\")\n",
        "print(Movie_data.head())"
