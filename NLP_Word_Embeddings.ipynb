            "  warnings.warn(\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#Splitting the data into trainig and testing\n",
        "X_train, X_test, Y_train, Y_test = train_test_split(text_counts, Movie_data['Sentiment'], test_size=0.25, random_state=5)"
      ],
