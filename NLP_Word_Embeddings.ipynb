          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#Pre-Processing and Bag of Word Vectorization using Count Vectorizer\n",
        "token = RegexpTokenizer(r'[a-zA-Z0-9]+') #[a-zA-Z0-9]+ indica que el tokenizer separa las palabras alfanuméricas y descarta los signos de puntuación.\n",
        "cv = CountVectorizer(stop_words='english', ngram_range = (1,1),tokenizer = token.tokenize) #ngram_range = (1,1) significa que considera palabra por palabra.  ngram_range = (1,2) sería considerar bigrams.\n",
        "text_counts = cv.fit_transform(Movie_data['Sentence'])"
      ],
