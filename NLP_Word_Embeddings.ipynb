    {
      "cell_type": "code",
      "source": [
        "from sklearn.feature_extraction.text import CountVectorizer\n",
        "from nltk.tokenize import RegexpTokenizer #RegexpTokenizer es una clase especial dentro de nltk\n",
        "import pandas as pd\n",
